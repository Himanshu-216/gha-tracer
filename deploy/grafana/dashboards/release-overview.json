{
  "uid": "gha-release-overview",
  "title": "Release overview",
  "tags": [
    "gha-tracer"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "",
  "time": {
    "from": "now-90d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "line",
        "label": "Release line (vMAJOR.MINOR)",
        "type": "textbox",
        "query": "v1.20",
        "current": {
          "text": "v1.20",
          "value": "v1.20"
        }
      },
      {
        "name": "tracer",
        "type": "constant",
        "hide": 2,
        "query": "http://gha-tracer:9090",
        "current": {
          "text": "http://gha-tracer:9090",
          "value": "http://gha-tracer:9090"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "In progress now (live)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "table",
      "title": "Running for $line",
      "description": "From gha-tracer memory. Empty after a restart until new events arrive.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 6
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "infinity"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "infinity"
          },
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "$tracer/api/active?release_line=$line",
          "url_options": {
            "method": "GET"
          },
          "root_selector": "",
          "columns": [
            {
              "selector": "repo",
              "text": "Repo",
              "type": "string"
            },
            {
              "selector": "workflow",
              "text": "Workflow",
              "type": "string"
            },
            {
              "selector": "release_line",
              "text": "Line",
              "type": "string"
            },
            {
              "selector": "version",
              "text": "Version",
              "type": "string"
            },
            {
              "selector": "change_type",
              "text": "Type",
              "type": "string"
            },
            {
              "selector": "status",
              "text": "Status",
              "type": "string"
            },
            {
              "selector": "conclusion",
              "text": "Conclusion",
              "type": "string"
            },
            {
              "selector": "duration_seconds",
              "text": "Duration",
              "type": "number"
            },
            {
              "selector": "jobs_completed",
              "text": "Jobs done",
              "type": "number"
            },
            {
              "selector": "jobs_total",
              "text": "Jobs seen",
              "type": "number"
            },
            {
              "selector": "jobs_failed",
              "text": "Jobs failed",
              "type": "number"
            },
            {
              "selector": "running_jobs",
              "text": "Running now",
              "type": "string"
            },
            {
              "selector": "head_sha",
              "text": "SHA",
              "type": "string"
            },
            {
              "selector": "started_at",
              "text": "Started",
              "type": "timestamp"
            },
            {
              "selector": "url",
              "text": "URL",
              "type": "string"
            }
          ]
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "URL"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open in GitHub",
                    "url": "${__value.raw}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Conclusion"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "success": {
                        "color": "green"
                      },
                      "failure": {
                        "color": "red"
                      },
                      "cancelled": {
                        "color": "orange"
                      },
                      "timed_out": {
                        "color": "red"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": 3,
      "type": "row",
      "title": "Monthly release ($line.0 across repos)",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 4,
      "type": "table",
      "title": "Release runs",
      "description": "One row per repo run triggered by the vX.Y.0 tag. Click the trace ID for the waterfall.",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ resource.gha.release_line = \"$line\" && resource.gha.change_type = \"release\" && span.gha.node_kind = \"run\" } | select(resource.vcs.repository.name, resource.gha.version, span.gha.conclusion, span.gha.html_url)",
          "limit": 200,
          "spss": 20,
          "tableType": "spans"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "row",
      "title": "Hotfixes on release/$line.x",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 6,
      "type": "table",
      "title": "Hotfix runs (merge to release/* and patch tag, pair by SHA)",
      "description": "hotfix-merge rows have no version yet; the hotfix-tag row with the same head_sha names it.",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ resource.gha.release_line = \"$line\" && resource.gha.change_type =~ \"hotfix-.*\" && span.gha.node_kind = \"run\" } | select(resource.vcs.repository.name, resource.gha.change_type, resource.gha.version, resource.gha.head_sha, span.gha.conclusion, span.gha.html_url)",
          "limit": 200,
          "spss": 20,
          "tableType": "spans"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "row",
      "title": "What failed",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 8,
      "type": "table",
      "title": "Failed jobs in $line",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ resource.gha.release_line = \"$line\" && span.gha.node_kind = \"job\" && status = error } | select(resource.vcs.repository.name, resource.gha.change_type, resource.gha.version, span.gha.conclusion, span.gha.runner_label, span.gha.html_url)",
          "limit": 200,
          "spss": 20,
          "tableType": "spans"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Slowest jobs in $line (> 10m)",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 29,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ resource.gha.release_line = \"$line\" && span.gha.node_kind = \"job\" && duration > 10m } | select(resource.vcs.repository.name, resource.gha.change_type, span.gha.runner_label)",
          "limit": 200,
          "spss": 20,
          "tableType": "spans"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
  ],
  "links": [
    {
      "title": "CI Releases",
      "type": "dashboards",
      "tags": [
        "gha-tracer"
      ],
      "asDropdown": true
    }
  ]
}
