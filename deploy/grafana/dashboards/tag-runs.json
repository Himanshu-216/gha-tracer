{
  "uid": "gha-tag-runs",
  "title": "Tag-triggered workflows",
  "tags": [
    "ci",
    "github-actions"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 41,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "repo",
        "label": "repo",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "qryType": 1,
          "query": "label_values(gha_tag_run_status, repo)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(gha_tag_run_status, repo)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "sort": 1,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "status",
        "label": "status",
        "type": "custom",
        "query": "All : >= 0,Running : == 0,Success : == 1,Failed : == 2,Cancelled : == 3,Timed out : == 4",
        "options": [
          {
            "text": "All",
            "value": ">= 0",
            "selected": true
          },
          {
            "text": "Running",
            "value": "== 0",
            "selected": false
          },
          {
            "text": "Success",
            "value": "== 1",
            "selected": false
          },
          {
            "text": "Failed",
            "value": "== 2",
            "selected": false
          },
          {
            "text": "Cancelled",
            "value": "== 3",
            "selected": false
          },
          {
            "text": "Timed out",
            "value": "== 4",
            "selected": false
          }
        ],
        "current": {
          "text": "All",
          "value": ">= 0"
        },
        "includeAll": false,
        "multi": false
      },
      {
        "name": "github_url",
        "type": "constant",
        "hide": 2,
        "query": "https://github.com",
        "current": {
          "text": "https://github.com",
          "value": "https://github.com"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Tag runs",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count((last_over_time(gha_tag_run_status{repo=~\"$repo\"}[$__range]) and on (repo, run_id, instance) topk by (repo, run_id) (1, last_over_time(gha_tag_run_updated_seconds{repo=~\"$repo\"}[$__range])) and on (repo, run_id) (last_over_time(gha_tag_run_started_seconds{repo=~\"$repo\"}[$__range]) >= $__from / 1000)) >= 0) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Succeeded",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count((last_over_time(gha_tag_run_status{repo=~\"$repo\"}[$__range]) and on (repo, run_id, instance) topk by (repo, run_id) (1, last_over_time(gha_tag_run_updated_seconds{repo=~\"$repo\"}[$__range])) and on (repo, run_id) (last_over_time(gha_tag_run_started_seconds{repo=~\"$repo\"}[$__range]) >= $__from / 1000)) == 1) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Failed / cancelled",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count((last_over_time(gha_tag_run_status{repo=~\"$repo\"}[$__range]) and on (repo, run_id, instance) topk by (repo, run_id) (1, last_over_time(gha_tag_run_updated_seconds{repo=~\"$repo\"}[$__range])) and on (repo, run_id) (last_over_time(gha_tag_run_started_seconds{repo=~\"$repo\"}[$__range]) >= $__from / 1000)) >= 2 < 5) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          },
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Running",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count((last_over_time(gha_tag_run_status{repo=~\"$repo\"}[$__range]) and on (repo, run_id, instance) topk by (repo, run_id) (1, last_over_time(gha_tag_run_updated_seconds{repo=~\"$repo\"}[$__range])) and on (repo, run_id) (last_over_time(gha_tag_run_started_seconds{repo=~\"$repo\"}[$__range]) >= $__from / 1000)) == 0) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Workflows triggered by a tag push",
      "description": "One row per run (re-runs show their latest attempt). Status of a workflow includes every reusable workflow it calls, so a failing child shows here as Failed.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 20
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (repo, workflow, tag, run_id, instance) ((last_over_time(gha_tag_run_status{repo=~\"$repo\"}[$__range]) and on (repo, run_id, instance) topk by (repo, run_id) (1, last_over_time(gha_tag_run_updated_seconds{repo=~\"$repo\"}[$__range])) and on (repo, run_id) (last_over_time(gha_tag_run_started_seconds{repo=~\"$repo\"}[$__range]) >= $__from / 1000)) $status)",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": ""
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (repo, workflow, tag, run_id, instance) ((last_over_time(gha_tag_run_started_seconds{repo=~\"$repo\"}[$__range]) and on (repo, run_id, instance) topk by (repo, run_id) (1, last_over_time(gha_tag_run_updated_seconds{repo=~\"$repo\"}[$__range])) and on (repo, run_id) (last_over_time(gha_tag_run_started_seconds{repo=~\"$repo\"}[$__range]) >= $__from / 1000)) * 1000 and on (repo, run_id, instance) ((last_over_time(gha_tag_run_status{repo=~\"$repo\"}[$__range]) and on (repo, run_id, instance) topk by (repo, run_id) (1, last_over_time(gha_tag_run_updated_seconds{repo=~\"$repo\"}[$__range])) and on (repo, run_id) (last_over_time(gha_tag_run_started_seconds{repo=~\"$repo\"}[$__range]) >= $__from / 1000)) $status))",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": ""
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (repo, workflow, tag, run_id, instance) (last_over_time(gha_tag_run_duration_seconds{repo=~\"$repo\"}[$__range]) and on (repo, run_id, instance) topk by (repo, run_id) (1, last_over_time(gha_tag_run_updated_seconds{repo=~\"$repo\"}[$__range])) and on (repo, run_id) (last_over_time(gha_tag_run_started_seconds{repo=~\"$repo\"}[$__range]) >= $__from / 1000) and on (repo, run_id, instance) ((last_over_time(gha_tag_run_status{repo=~\"$repo\"}[$__range]) and on (repo, run_id, instance) topk by (repo, run_id) (1, last_over_time(gha_tag_run_updated_seconds{repo=~\"$repo\"}[$__range])) and on (repo, run_id) (last_over_time(gha_tag_run_started_seconds{repo=~\"$repo\"}[$__range]) >= $__from / 1000)) $status))",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": ""
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "instance": true
            },
            "indexByName": {
              "Value #B": 0,
              "repo": 1,
              "workflow": 2,
              "tag": 3,
              "Value #A": 4,
              "Value #C": 5,
              "run_id": 6
            },
            "renameByName": {
              "Value #B": "Started",
              "repo": "Repo",
              "workflow": "Workflow",
              "tag": "Tag",
              "Value #A": "Status",
              "Value #C": "Duration",
              "run_id": "Run"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Started"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsLocal"
              },
              {
                "id": "custom.width",
                "value": 190
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "Running",
                        "color": "blue",
                        "index": 0
                      },
                      "1": {
                        "text": "Success",
                        "color": "green",
                        "index": 1
                      },
                      "2": {
                        "text": "Failed",
                        "color": "red",
                        "index": 2
                      },
                      "3": {
                        "text": "Cancelled",
                        "color": "orange",
                        "index": 3
                      },
                      "4": {
                        "text": "Timed out",
                        "color": "red",
                        "index": 4
                      },
                      "5": {
                        "text": "Other",
                        "color": "text",
                        "index": 5
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "custom.width",
                "value": 130
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.width",
                "value": 120
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Run"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open run in GitHub",
                    "targetBlank": true,
                    "url": "${github_url}/${__data.fields.Repo}/actions/runs/${__value.raw}"
                  }
                ]
              },
              {
                "id": "custom.width",
                "value": 140
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Started",
            "desc": true
          }
        ],
        "footer": {
          "show": false
        }
      }
    }
  ]
}
